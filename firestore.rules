rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 3. Path Variable Hardening (Phase 3 Primitives)
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Validation Blueprints (Phase 4)
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email'])
          && data.uid == request.auth.uid
          && data.email is string && data.email.size() <= 256
          && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 128));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
                   && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'theme', 'onboarding']);
      
      // Profile Sub-collection
      match /profile/{profileDocId} {
        function isValidProfile(data) {
          return (data.displayName == null || (data.displayName is string && data.displayName.size() <= 128))
              && (data.bio == null || (data.bio is string && data.bio.size() <= 2000))
              && (data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 2000000))
              && (data.cropZoom == null || data.cropZoom is number)
              && (data.primaryObjective == null || (data.primaryObjective is string && data.primaryObjective.size() <= 100))
              && (data.companionTone == null || (data.companionTone is string && data.companionTone.size() <= 100))
              && (data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 200));
        }
        allow get: if isOwner(userId) && isValidId(profileDocId);
        allow create, update: if isOwner(userId) && isValidId(profileDocId) && isValidProfile(incoming());
      }
      
      // Sub-collections
      match /tasks/{taskId} {
        function isValidTask(data) {
          return data.keys().hasAll(['userId', 'title', 'status'])
              && data.userId == request.auth.uid
              && data.title is string && data.title.size() <= 200
              && data.status in ['todo', 'in-progress', 'completed', 'archived']
              && (data.priority == null || data.priority in ['low', 'medium', 'high', 'ai-suggested']);
        }
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTask(incoming()) && incoming().createdAt == request.time;
        allow update: if isOwner(userId) && isValidTask(incoming()) 
                     && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'status', 'priority', 'dueDate', 'tags'])
                     && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      match /courses/{courseId} {
        function isValidCourse(data) {
          return data.keys().hasAll(['userId', 'name', 'category', 'progress', 'totalLessons', 'completedLessons'])
              && data.userId == request.auth.uid
              && data.name is string && data.name.size() <= 250
              && data.category is string && data.category.size() <= 150
              && data.progress is number && data.progress >= 0 && data.progress <= 100
              && data.completedLessons is number && data.completedLessons >= 0
              && data.totalLessons is number && data.totalLessons >= 0;
        }
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCourse(incoming()) && (incoming().createdAt == null || incoming().createdAt == request.time);
        allow update: if isOwner(userId) && isValidCourse(incoming())
                     && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'progress', 'totalLessons', 'completedLessons'])
                     && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      match /moodLogs/{logId} {
        function isValidMoodLog(data) {
          return data.keys().hasAll(['userId', 'mood', 'note'])
              && data.userId == request.auth.uid
              && data.mood is string && data.mood.size() <= 100
              && data.note is string && data.note.size() <= 2000;
        }
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidMoodLog(incoming()) && (incoming().createdAt == null || incoming().createdAt == request.time);
        allow delete: if isOwner(userId);
      }

      match /gamification/{gamificationDocId} {
        function isValidGamification(data) {
          return data.xp is number
              && data.level is number
              && data.streak is number;
        }
        allow get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidGamification(incoming());
      }

      match /decisions/{decisionId} {
        function isValidDecision(data) {
          return data.keys().hasAll(['userId', 'problem'])
              && data.userId == request.auth.uid
              && data.problem is string && data.problem.size() <= 1000;
        }
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDecision(incoming());
        allow update: if isOwner(userId) && isValidDecision(incoming())
                     && incoming().diff(existing()).affectedKeys().hasOnly(['options', 'analysis', 'recommendation', 'status']);
        allow delete: if isOwner(userId);
      }
    }
  }
}
